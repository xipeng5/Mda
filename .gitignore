# 虚拟环境与缓存
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# 打包产物
build/
dist/
*.spec
!packaging/*.spec

# macOS
.DS_Store

# ===== 样本与第三方二进制（刻意不入库）=====
# 逆向目标 App 的 so 属他人二进制，公开仓库不收录；
# 需要跑测试请自备 AOSP 的 liblog/libbase/libcutils 放入 samples/。
samples/
so_test/
tools/frida-server-*

# 运行期产物
*.log

# PyInstaller 缓存（沙箱内构建用）
.pyinstaller/

# ===== Web 前端（源码入库，依赖与构建产物不入库）=====
web/node_modules/
web/.npm-cache/

# 拖入文件的落盘目录
.cache/

# UI 评审截图/临时产物（体积大，不入库）
docs/ui-review/

# 前端导出的示例数据（由 tests/ui_review/dump_sphere_data.py 生成，不入库）
web/public/data.js
