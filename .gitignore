# 虚拟环境与缓存
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# 打包产物
build/
dist/
*.spec
!packaging/*.spec

# macOS
.DS_Store

# ===== 样本与第三方二进制（刻意不入库）=====
# 逆向目标 App 的 so 属他人二进制，公开仓库不收录；
# 需要跑测试请自备 AOSP 的 liblog/libbase/libcutils 放入 samples/。
samples/
so_test/
tools/frida-server-*

# 运行期产物
*.log

# PyInstaller 缓存（沙箱内构建用）
.pyinstaller/

# ===== Web 前端（源码入库，依赖与构建产物不入库）=====
web/node_modules/
web/.npm-cache/

# 拖入文件的落盘目录
.cache/

# UI 评审截图/临时产物（体积大，不入库）
docs/ui-review/

# 前端导出的示例数据（由 tests/ui_review/dump_sphere_data.py 生成，不入库）
web/public/data.js

# ===== 会话/记忆存储（不入库）=====
# 含设备序列号、本机绝对路径等环境相关信息；
# 且是工具运行期产物，不属于项目源码。
.dsh/

# PyInstaller spec 的手工备份（同内容，无新信息）
*.spec.bak

# 设备端 helper 编译产物（由 dyn/device/build.sh 生成，不入库）
dyn/device/mda_perfwatch

# perf_event 探针的编译产物（ARM64 ELF，由同目录 .c 编译得到，不入库）
# 只提交 .c 源码，二进制随平台变、体积大，且不该混进仓库历史
tests/probe_perf/hwslot
tests/probe_perf/perf_probe
tests/probe_perf/perf_probe2
tests/probe_perf/perf_remote
tests/probe_perf/perf_thread
tests/probe_perf/perf_v3
tests/probe_perf/perf_v4
tests/probe_perf/perf_v5
dyn/device/mda_memsnap
